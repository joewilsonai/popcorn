{
  "manifest_version": 3,
  "name": "Popcorn",
  "version": "0.3.0",
  "description": "Researched facts that pop up over YouTube videos while they play. Runs on your own Claude or ChatGPT subscription.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "bg.js" },
  "permissions": ["alarms", "storage"],
  "host_permissions": ["http://127.0.0.1:8931/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["overlay.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
